# Python
__pycache__/
*.pyc

# 仮想環境
venv/

# PyInstallerのビルド成果物 (巨大なバイナリのため管理外)
build/
dist/

# pip/setuptools のビルド成果物 (pip install -e . 等で生成される)
*.egg-info/

# 実行時に生成される一時ファイル
*.log
autosave.pkl
# .pklから.graphica形式への移行後の実際のオートセーブファイル名
# (無印+世代番号、複数タブ分の autosave_tab{N} 系列すべてを含む)
autosave*.graphica
autosave*.pkl

# Git管理を始める前に手動で作っていた作業バックアップ
Graphica_project_backup_*/

# Claude Codeのローカル専用設定 (この環境固有のため共有しない)
.claude/settings.local.json
.coverage
